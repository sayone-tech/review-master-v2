DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-insecure-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_VITE_DEV_MODE=True
DATABASE_URL=postgres://app:app@db:5432/reviewmaster
REDIS_URL=redis://redis:6379
SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_REPLY_TO=support@example.com

# Google OAuth (Google Business Profile)
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Local dev callback — must match exactly what you register in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback/

# OAuth token encryption (Phase 8+)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Not required in local
FERNET_SALT_KEY=

# Sentry — error tracking for web AND Celery worker (Phase 10).
# Leave SENTRY_DSN unset locally; Sentry stays silent.
# Not required in local
SENTRY_DSN=
ENVIRONMENT=local

# OpenAI — review enrichment (Phase 12+)
# Required in production; leave empty locally to skip enrichment calls.
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini-2024-07-18
OPENAI_MODEL=gpt-4o-mini-2024-07-18
# Optional tuning knobs (defaults shown)
OPENAI_MAX_RETRIES=3
# Max characters of review text sent to OpenAI (D-21 — input length guardrail)
OPENAI_REVIEW_TEXT_MAX_CHARS=4000
ENRICHMENT_BATCH_SIZE=10

# LangSmith — AI call tracing (Phase 12+)
# Leave unset to disable tracing (best-effort — OpenAI calls still proceed without it).
LANGSMITH_API_KEY=
# Optional — defaults to "review-platform-{ENVIRONMENT}"
LANGSMITH_PROJECT=review-platform-local
# Optional — set this if your LangSmith project is on the AWS-hosted endpoint.
# AWS endpoint: https://aws.api.smith.langchain.com
# Default (US): https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Sync tuning (Phase 11+) — optional, defaults shown
INITIAL_SYNC_PAGE_SIZE=50
INCREMENTAL_SYNC_INTERVAL_HOURS=6
INCREMENTAL_SYNC_JITTER_MINUTES=30

# Canonical tag vocabulary injection cap (Phase 22+ / D-02 / CTAG-03).
# Top-N canonical tags injected into the enrichment prompt; guards against
# unbounded prompt-token growth. Optional — default shown.
CANONICAL_VOCAB_INJECT_LIMIT=200

# Per-worker Celery rate limit for enrich_review_task (Phase 22+ / QUEUE-02 / D-06).
# This is PER-WORKER, not global. Default computed as ~500/min target ÷ ~4 expected
# workers. True cross-worker global throttling is deferred to Phase 23.
# Valid formats: "<n>/s", "<n>/m", "<n>/h". Optional — default shown.
ENRICHMENT_RATE_LIMIT=125/m

# Transactional email
# Locally: MailHog captures all outgoing email at http://localhost:8025 (no config needed).
# In production, set EMAIL_PROVIDER to select the backend:
#   "resend" (default) — Resend SMTP relay; set RESEND_API_KEY
#   "ses"              — Amazon SES; set the AWS_SES_* vars below (requires SES production access)
EMAIL_PROVIDER=resend

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Amazon SES (switch EMAIL_PROVIDER=ses once SES production access is granted)
AWS_SES_REGION_NAME=us-east-1
AWS_SES_FROM_EMAIL=noreply@example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
