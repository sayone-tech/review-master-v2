# Production environment file — populated on the EC2 box from SSM Parameter Store
# at boot by scripts/fetch-ssm-env.sh. Do NOT commit a populated copy.
#
# Lives at /etc/review-master/app.env on the box, mode 0640, owner root:docker.

# ---- Image ----
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
AWS_REGION=us-east-1

# ---- Domain / TLS ----
DOMAIN=app.example.com

# ---- Django ----
DJANGO_SECRET_KEY=replace-from-ssm
DJANGO_ALLOWED_HOSTS=app.example.com

# ---- Database (RDS) ----
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://app:replace-from-ssm@review-master-prod.xxxxxxx.us-east-1.rds.amazonaws.com:5432/reviewmaster

# ---- OpenAI ----
OPENAI_API_KEY=replace-from-ssm
OPENAI_MODEL=gpt-4o-mini-2024-07-18

# ---- Google Business Profile OAuth ----
GOOGLE_OAUTH_CLIENT_ID=replace-from-ssm
GOOGLE_OAUTH_CLIENT_SECRET=replace-from-ssm

# ---- LangSmith (optional, best-effort) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=review-platform-prod

# ---- Sentry (optional) ----
SENTRY_DSN=

# ---- S3 static files ----
AWS_STORAGE_BUCKET_NAME=review-master-prod-static

# ---- Email (provisional until SES production access) ----
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_REPLY_TO=support@example.com

# ---- Celery worker ----
CELERY_WORKER_CONCURRENCY=2

# ---- Flower (basic auth: user:password) ----
FLOWER_BASIC_AUTH=admin:replace-from-ssm
